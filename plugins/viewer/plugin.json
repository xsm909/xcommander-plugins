        "helmignore",
        "npmignore",
        "npmrc",
        "prettierignore",
        "pylintrc"
      ],
      "render": {
        "kind": "text",
        "encoding": "utf-8",
        "syntax": "auto",
        "maxBytes": 2097152
      },
      "fallback": true
    },
    {
      "id": "builtin.markdown",
      "title": "Markdown",
      "priority": 40,
      "extensions": [
        "md",
        "markdown",
        "mdown",
        "mkd",
        "mdx"
      ],
      "render": {
        "kind": "markdown",
        "encoding": "utf-8",
        "maxBytes": 4194304
      }
    },
    {
      "id": "builtin.json.pretty",
      "title": "Formatted JSON",
      "priority": 30,
      "extensions": [
        "json",
        "jsonc",
        "geojson",
        "webmanifest"
      ],
      "render": {
        "kind": "text",
        "transform": "json-pretty",
        "maxBytes": 8388608
      }
    },
    {
      "id": "builtin.json.table",
      "title": "JSON as table",
      "priority": 25,
      "extensions": [
        "json",
        "geojson"
      ],
      "render": {
        "kind": "table",
        "source": "json",
        "maxBytes": 8388608,
        "maxRows": 5000
      }
    },
    {
      "id": "builtin.csv",
      "title": "Table",
      "priority": 20,
      "extensions": [
        "csv"
      ],
      "render": {
        "kind": "table",
        "source": "csv",
        "delimiter": "auto",
        "hasHeader": true,
        "maxBytes": 4194304,
        "maxRows": 5000
      }
    },
    {
      "id": "builtin.tsv",
      "title": "Table",
      "priority": 20,
      "extensions": [
        "tsv",
        "tab"
      ],
      "render": {
        "kind": "table",
        "source": "tsv",
        "hasHeader": true,
        "maxBytes": 4194304,
        "maxRows": 5000
      }
    },
    {
      "id": "builtin.lines",
      "title": "Numbered lines",
      "priority": 5,
      "extensions": [
        "log",
        "out",
        "err",
        "txt",
        "csv",
        "tsv"
      ],
      "render": {
        "kind": "table",
        "source": "lines",
        "maxBytes": 2097152,
        "maxRows": 20000
      }
    },
    {
      "id": "builtin.hex",
      "title": "Hex dump",
      "priority": 0,
      "extensions": [
        "*"
      ],
      "render": {
        "kind": "hex",
        "maxBytes": 262144
      }
    }
