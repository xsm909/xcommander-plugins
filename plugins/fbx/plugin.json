{
  "id": "org.xcommander.fbx",
  "name": "3D",
  "version": "0.11.0",
  "description": "Shows a 3D model: shaded, turnable, textured, playing its animation — and what the file holds. FBX, glTF/GLB and OBJ, one viewer for all of them.",
  "category": "Viewers",
  "author": "xcommander",
  "homepage": "https://github.com/xsm909/xcommander-plugins",
  "apiVersion": 1,
  "runtime": "python",
  "entry": "main.py",
  "pythonMin": "3.12",
  "icon": "view",
  "platforms": [
    "windows",
    "macos",
    "linux"
  ],
  "viewers": [
    {
      "id": "fbx.model",
      "title": "Model",
      "extensions": [
        "fbx",
        "glb",
        "gltf",
        "obj"
      ],
      "priority": 20
    },
    {
      "id": "fbx.contents",
      "title": "What is in the file",
      "extensions": [
        "fbx",
        "glb",
        "gltf",
        "obj"
      ],
      "priority": 10
    }
  ]
}
